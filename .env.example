# Copy to .env.local and fill in. Placeholders only - never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Canonical origin: sitemap, robots, canonical tags, emails. REQUIRED in production, no trailing slash.
SITE_URL=http://localhost:3000
# Search-engine indexing. Leave ALLOW_INDEXING unset: only a real production domain is indexed. localhost and *.vercel.app
# (test and preview deployments) are blocked automatically (robots.txt, empty sitemap, noindex). Set to true ONLY if you deliberately
# want such a host indexed; false forces indexing off everywhere.
# ALLOW_INDEXING=

# Email notifications (Resend). Without these, emails are skipped and the app says so; it never fakes a send.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=YOUR_EMAIL_API_KEY
EMAIL_FROM_ADDRESS=PostAtlas <no-reply@example.com>

# Where contact form, write-for-us, payment and advice alerts go (kept server-side).
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Protects /api/cron/monitor. Generate with: openssl rand -hex 32  (min 24 chars)
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# ---- Third-party SEO data (OPTIONAL) -------------------------------------------------------------------------
# The app starts and the technical checks work with none of these set. Without a provider the report says that
# Domain Rating, backlinks, traffic and keyword data are not connected; it never shows made-up numbers.
# SEO_PROVIDER: none (default) | ahrefs-free | ahrefs
#   ahrefs-free  Domain Rating only, for ANY domain. Needs just a FREE Ahrefs APIv3 key (Ahrefs account > Account settings > API keys).
#                Uses Ahrefs' free endpoint, costs no API units. Ahrefs requires the attribution "Domain Rating by Ahrefs" (the report shows it).
#   ahrefs       Full data (backlinks, traffic, keywords). Needs an eligible PAID Ahrefs plan with API access (consumes API units).
#                If DR is refused for a free key, it falls back to the free endpoint automatically.
SEO_PROVIDER=none
AHREFS_API_KEY=
# Reuse a stored provider result for the same domain for this many hours (1-720, default 72).
SEO_CACHE_HOURS=72
# Global cap on paid provider lookups per day (default 150).
SEO_PROVIDER_DAILY_BUDGET=150

# ---- Pricing, currencies and payouts -----------------------------------------------------------------------------
# USD->PKR rates: by default the keyless open.er-api.com feed is used (daily market rate, attribution required, check its
# terms for commercial use). Set FX_API_KEY to use exchangerate-api.com's keyed plan instead (same data, clear licence).
FX_API_KEY=
# 32 random bytes, base64. Encrypts publisher bank details. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes saved payout details unreadable; back it up in your secret manager.
PAYOUT_DATA_KEY=GENERATE_32_RANDOM_BYTES_BASE64
# Hours the original publisher has to restore a missing link (default 72).
RESTORE_DEADLINE_HOURS=72
